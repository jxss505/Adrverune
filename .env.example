# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADVERUNE ENQUIRY NOTIFICATION SYSTEM
# Recipient verified email for commercial intake notifications
RECIPIENT_EMAIL="officialjassmanager@gmail.com"

# SMTP Provider Credentials (e.g. Gmail, SendGrid, Amazon SES, Postmark, Resend SMTP)
# When configured, inquiries are automatically dispatched via SMTP.
# When not configured, inquiries are securely processed and logged in the server console.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="\"ADVERUNE Intake Desk\" <no-reply@adverune.com>"

# SUPABASE POSTGRESQL DATABASE CONFIGURATION
# Connects ADVERUNE to your Supabase PostgreSQL project for lead storage
SUPABASE_URL="https://[YOUR_SUPABASE_PROJECT_ID].supabase.co"
SUPABASE_PUBLISHABLE_KEY="[YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY]"
# Optional: Dedicated server-only service_role key for elevated administrative access (Never expose to client)
# SUPABASE_SERVICE_ROLE_KEY="[YOUR_SUPABASE_SERVICE_ROLE_KEY]"

# GOOGLE ANALYTICS 4 (GA4) TELEMETRY CONFIGURATION
# Replace [GA4_MEASUREMENT_ID] with your production GA4 Measurement ID (e.g. G-ABC123XYZ0)
# When set to [GA4_MEASUREMENT_ID] or omitted, GA4 runs in developer debug mode (logging events to console).
VITE_GA4_MEASUREMENT_ID="[GA4_MEASUREMENT_ID]"

